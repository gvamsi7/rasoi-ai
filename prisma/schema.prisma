generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()); email String @unique; createdAt DateTime @default(now()); favorites Favorite[]; shoppingItems ShoppingItem[] }
model Favorite { id String @id @default(cuid()); userId String; recipeSlug String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([userId,recipeSlug]) }
model ShoppingItem { id String @id @default(cuid()); userId String; name String; checked Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]) }
